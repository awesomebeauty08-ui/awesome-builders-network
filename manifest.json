<script>
function toggleMenu() {
  document.getElementById("navigation")
    .classList.toggle("open");
}

document.querySelectorAll("#navigation a").forEach(link => {
  link.addEventListener("click", () => {
    document.getElementById("navigation")
      .classList.remove("open");
  });
});

document.getElementById("year").textContent =
  new Date().getFullYear();

document.getElementById("applicationForm")
.addEventListener("submit", function(event) {

  event.preventDefault();

  const accepted =
    document.getElementById("termsAccepted").checked &&
    document.getElementById("privacyAccepted").checked;

  if (!accepted) {
    alert("Please accept the Terms and Privacy Policy.");
    return;
  }

  document.getElementById("formMessage").textContent =
    "Your application details have passed the local form checks. " +
    "Live submission is not yet connected. Please do not treat " +
    "this message as confirmation of membership or verification.";

  this.reset();
});
