
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#101010">

<title>Awesome Builders Network | ABN-7742</title>

<meta name="description" content="Awesome Builders Network connects businesses, professionals, suppliers and skilled service providers across the building and construction industry.">

<style>
:root {
  --gold: #c9a34b;
  --gold-light: #e5c77e;
  --black: #101010;
  --dark: #181818;
  --white: #ffffff;
  --muted: #b5b5b5;
  --border: #333;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  scroll-behavior: smooth;
}

body {
  background: var(--black);
  color: var(--white);
  font-family: Arial, Helvetica, sans-serif;
  line-height: 1.7;
}

a {
  color: inherit;
  text-decoration: none;
}

button, input, select, textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

header {
  background: rgba(16,16,16,.97);
  border-bottom: 1px solid var(--border);
  padding: 15px 6%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  position: sticky;
  top: 0;
  z-index: 100;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-mark {
  width: 48px;
  height: 48px;
  border: 2px solid var(--gold);
  color: var(--gold);
  border-radius: 50%;
  display: grid;
  place-items: center;
  font-weight: bold;
  font-size: 14px;
}

.brand-name {
  font-size: 15px;
  font-weight: bold;
  letter-spacing: 1px;
}

.brand-name span {
  display: block;
  color: var(--gold);
  font-size: 11px;
}

nav {
  display: flex;
  align-items: center;
  gap: 20px;
  flex-wrap: wrap;
}

nav a {
  font-size: 13px;
  color: #ddd;
}

nav a:hover {
  color: var(--gold);
}

.menu-btn {
  display: none;
  color: var(--gold);
  background: none;
  border: 1px solid var(--gold);
  padding: 7px 12px;
}

.hero {
  min-height: 570px;
  padding: 100px 8%;
  display: flex;
  align-items: center;
  background:
    radial-gradient(ellipse at 80% 30%, #493817 0%, transparent 40%),
    linear-gradient(130deg, #101010, #202020);
}

.hero-content {
  max-width: 850px;
}

.eyebrow {
  color: var(--gold);
  font-size: 13px;
  letter-spacing: 3px;
  font-weight: bold;
  text-transform: uppercase;
}

h1 {
  font-size: clamp(36px, 6vw, 65px);
  line-height: 1.12;
  margin: 22px 0;
}

h1 span, h2 span {
  color: var(--gold);
}

.hero p {
  max-width: 680px;
  color: #ccc;
  font-size: 17px;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: 30px;
}

.btn {
  display: inline-block;
  border: 1px solid var(--gold);
  padding: 13px 23px;
  font-weight: bold;
  border-radius: 4px;
  font-size: 14px;
}

.btn-gold {
  background: var(--gold);
  color: #111;
}

.btn-outline {
  color: var(--gold);
  background: transparent;
}

.btn:hover {
  opacity: .85;
}

section {
  padding: 75px 7%;
  scroll-margin-top: 85px;
}

.section-heading {
  max-width: 750px;
  margin: 0 auto 40px;
  text-align: center;
}

.section-heading h2 {
  font-size: clamp(27px, 4vw, 39px);
  margin-bottom: 13px;
}

.section-heading p {
  color: var(--muted);
}

.dark-section {
  background: var(--dark);
}

.gold-line {
  width: 65px;
  height: 3px;
  background: var(--gold);
  margin: 17px auto;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 20px;
}

.card {
  background: #1b1b1b;
  border: 1px solid var(--border);
  padding: 25px;
  border-radius: 7px;
}

.card h3 {
  color: var(--gold-light);
  margin-bottom: 12px;
  font-size: 19px;
}

.card p, .card li {
  color: #c4c4c4;
  font-size: 14px;
}

.card ul {
  padding-left: 18px;
}

.number {
  font-size: 30px;
  color: var(--gold);
  margin-bottom: 12px;
}

.about-text {
  max-width: 900px;
  margin: auto;
  color: #ccc;
}

.about-text p {
  margin-bottom: 17px;
}

.highlight {
  border-left: 3px solid var(--gold);
  padding: 18px 23px;
  background: #202020;
  margin: 25px 0;
}

.category-card {
  text-align: center;
  min-height: 140px;
}

.category-card h3 {
  font-size: 16px;
}

.membership {
  border-top: 3px solid var(--gold);
}

.membership small {
  color: var(--gold-light);
}

.membership ul {
  margin: 18px 0;
}

.note {
  color: #aaa;
  font-size: 13px;
  margin-top: 15px;
}

form {
  max-width: 750px;
  margin: auto;
  background: #1b1b1b;
  border: 1px solid var(--border);
  border-radius: 7px;
  padding: 28px;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}

.field {
  margin-bottom: 17px;
}

.field label {
  display: block;
  font-size: 13px;
  margin-bottom: 7px;
  color: var(--gold-light);
}

.field input,
.field select,
.field textarea {
  width: 100%;
  padding: 13px;
  background: #101010;
  color: white;
  border: 1px solid #444;
  border-radius: 4px;
}

.field textarea {
  min-height: 100px;
}

.full {
  grid-column: 1 / -1;
}

.checkline {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  margin: 17px 0;
  color: #ccc;
  font-size: 13px;
}

.checkline input {
  margin-top: 5px;
}

.form-message {
  color: var(--gold-light);
  margin-top: 15px;
  font-size: 14px;
}

.policy {
  max-width: 950px;
  margin: auto;
}

.policy h3 {
  color: var(--gold-light);
  margin: 28px 0 10px;
}

.policy p, .policy li {
  color: #c5c5c5;
  font-size: 14px;
  margin-bottom: 12px;
}

.policy ol, .policy ul {
  padding-left: 22px;
}

.policy-date {
  color: var(--gold);
  font-size: 13px;
}

.cta {
  text-align: center;
  background: linear-gradient(120deg, #211c12, #171717);
}

footer {
  padding: 45px 7%;
  background: #080808;
  border-top: 1px solid #333;
}

.footer-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 30px;
}

footer h3 {
  color: var(--gold);
  margin-bottom: 12px;
}

footer p, footer a {
  color: #aaa;
  font-size: 13px;
}

footer a {
  display: block;
  margin: 6px 0;
}

.copyright {
  text-align: center;
  border-top: 1px solid #333;
  margin-top: 30px;
  padding-top: 20px;
  color: #888;
  font-size: 12px;
}

@media(max-width:850px) {
  nav {
    display: none;
    position: absolute;
    top: 75px;
    left: 0;
    width: 100%;
    background: #151515;
    padding: 20px;
    flex-direction: column;
    align-items: flex-start;
    border-bottom: 1px solid var(--gold);
  }

  nav.open {
    display: flex;
  }

  .menu-btn {
    display: block;
  }

  .hero {
    min-height: 480px;
    padding: 75px 7%;
  }

  section {
    padding: 60px 6%;
  }
}

@media(max-width:550px) {
  .form-grid {
    grid-template-columns: 1fr;
  }

  .full {
    grid-column: auto;
  }

  h1 {
    font-size: 39px;
  }
}
</style>
</head>

<body>

<header>
  <a href="#home" class="brand">
    <div class="brand-mark">ABN</div>
    <div class="brand-name">
      AWESOME BUILDERS NETWORK
      <span>ABN-7742</span>
    </div>
  </a>

  <button class="menu-btn" onclick="toggleMenu()">MENU</button>

  <nav id="navigation">
    <a href="#home">Home</a>
    <a href="#about">About</a>
    <a href="#categories">Categories</a>
    <a href="#membership">Membership</a>
    <a href="#benefits">Benefits</a>
    <a href="#join">Join ABN</a>
    <a href="#terms">Terms</a>
    <a href="#contact">Contact</a>
  </nav>
</header>

<!-- HOME -->

<main>

<section class="hero" id="home">
  <div class="hero-content">
    <div class="eyebrow">A professional industry network</div>

    <h1>
      ONE NETWORK.<br>
      <span>THE ENTIRE INDUSTRY.</span>
    </h1>

    <p>
      Welcome to Awesome Builders Network (ABN-7742),
      a professional network connecting businesses,
      industry professionals, suppliers and skilled
      service providers across the building and
      construction industry.
    </p>

    <div class="actions">
      <a href="#join" class="btn btn-gold">BECOME A MEMBER</a>
      <a href="#about" class="btn btn-outline">DISCOVER ABN</a>
    </div>
  </div>
</section>

<!-- INTRODUCTION -->

<section id="about">
  <div class="section-heading">
    <div class="eyebrow">Who we are</div>
    <h2>Welcome to <span>ABN-7742</span></h2>
    <div class="gold-line"></div>
  </div>

  <div class="about-text">
    <p>
      Awesome Builders Network is an industry-focused
      professional and business networking platform
      designed to bring together the people and
      organisations that make the building and
      construction industry work.
    </p>

    <p>
      From construction companies and contractors to
      architects, engineers, artisans, suppliers and
      specialist service providers, ABN provides a
      shared environment for professional visibility,
      business discovery, networking and growth.
    </p>

    <p>
      We believe that meaningful industry connections
      should go beyond simply exchanging contact
      details. Members should have opportunities to
      establish their professional presence, discover
      opportunities, build relationships and connect
      with potential clients and collaborators.
    </p>

    <div class="highlight">
      <strong>Our principle:</strong>
      A stronger industry begins with stronger
      professional connections.
    </div>

    <p>
      ABN is designed to serve both businesses and
      individual professionals, recognising that each
      plays an important role in the industry.
    </p>
  </div>
</section>

<!-- VISION MISSION VALUES -->

<section class="dark-section" id="vision">
  <div class="section-heading">
    <div class="eyebrow">Our foundation</div>
    <h2>Vision, Mission & <span>Values</span></h2>
    <div class="gold-line"></div>
  </div>

  <div class="grid">
    <div class="card">
      <div class="number">01</div>
      <h3>Our Vision</h3>
      <p>
        To become a trusted and recognised professional
        network connecting the building and construction
        industry, creating opportunities for businesses,
        professionals and skilled providers to grow.
      </p>
    </div>

    <div class="card">
      <div class="number">02</div>
      <h3>Our Mission</h3>
      <p>
        To provide an organised platform for industry
        visibility, professional networking, business
        discovery, referrals and digital business
        development.
      </p>
    </div>

    <div class="card">
      <div class="number">03</div>
      <h3>Our Values</h3>
      <ul>
        <li>Professionalism</li>
        <li>Integrity</li>
        <li>Transparency</li>
        <li>Innovation</li>
        <li>Collaboration</li>
        <li>Accountability</li>
        <li>Continuous growth</li>
      </ul>
    </div>
  </div>
</section>

<!-- CATEGORIES -->

<section id="categories">
  <div class="section-heading">
    <div class="eyebrow">Industry coverage</div>
    <h2>Explore Our <span>Industry Categories</span></h2>
    <p>
      ABN welcomes qualified businesses and professionals
      operating across different areas of the building
      and construction ecosystem.
    </p>
  </div>

  <div class="grid">

    <div class="card category-card">
      <h3>Construction & Building</h3>
      <p>Building contractors, construction firms and project providers.</p>
    </div>

    <div class="card category-card">
      <h3>Architecture</h3>
      <p>Architects, architectural designers and consultants.</p>
    </div>

    <div class="card category-card">
      <h3>Engineering</h3>
      <p>Civil, structural, mechanical and electrical engineering.</p>
    </div>

    <div class="card category-card">
      <h3>Electrical Services</h3>
      <p>Electrical contractors and installation professionals.</p>
    </div>

    <div class="card category-card">
      <h3>Plumbing & Water</h3>
      <p>Plumbers, borehole providers and water-system specialists.</p>
    </div>

    <div class="card category-card">
      <h3>Interior Design</h3>
      <p>Interior designers, decorators and finishing specialists.</p>
    </div>

    <div class="card category-card">
      <h3>Building Materials</h3>
      <p>Material suppliers, distributors and dealers.</p>
    </div>

    <div class="card category-card">
      <h3>Artisans & Skilled Trades</h3>
      <p>Masons, carpenters, welders, painters and other skilled providers.</p>
    </div>

    <div class="card category-card">
      <h3>Real Estate & Property</h3>
      <p>Property-related businesses and professional service providers.</p>
    </div>

    <div class="card category-card">
      <h3>Surveying & Land Services</h3>
      <p>Surveyors and related technical professionals.</p>
    </div>

    <div class="card category-card">
      <h3>Consultancy & Project Services</h3>
      <p>Project management, quantity surveying and advisory services.</p>
    </div>

    <div class="card category-card">
      <h3>Other Industry Services</h3>
      <p>Other relevant businesses and professionals may apply.</p>
    </div>

  </div>
</section>

<!-- MEMBERSHIP -->

<section class="dark-section" id="membership">
  <div class="section-heading">
    <div class="eyebrow">Join the network</div>
    <h2>Membership <span>Structure</span></h2>
    <p>
      ABN provides membership pathways for businesses
      and individual professionals.
    </p>
  </div>

  <div class="grid">

    <div class="card membership">
      <small>MEMBERSHIP TYPE 01</small>
      <h3>Business Membership</h3>

      <p>
        Designed for registered businesses, companies,
        contractors, suppliers, dealers and service
        providers.
      </p>

      <ul>
        <li>Business presence within the ABN network</li>
        <li>Business discovery opportunities</li>
        <li>Access to applicable membership benefits</li>
        <li>Independent business website benefit, subject to plan and agreement</li>
        <li>Business networking opportunities</li>
        <li>Potential customer enquiry opportunities</li>
      </ul>

      <a href="#join" class="btn btn-gold">APPLY AS A BUSINESS</a>
    </div>

    <div class="card membership">
      <small>MEMBERSHIP TYPE 02</small>
      <h3>Professional Membership</h3>

      <p>
        Designed for individual professionals,
        consultants and skilled industry practitioners.
      </p>

      <ul>
        <li>Professional profile within ABN</li>
        <li>Professional visibility</li>
        <li>Networking with industry colleagues</li>
        <li>Professional activity and posting opportunities</li>
        <li>Colleague referral opportunities</li>
        <li>Eligibility to apply for Ambassador opportunities</li>
      </ul>

      <a href="#join" class="btn btn-gold">APPLY AS A PROFESSIONAL</a>
    </div>

  </div>

  <p class="note" style="text-align:center">
    Membership subscriptions are available on a weekly
    or monthly basis only. Applicable fees and benefits
    will be communicated before enrolment.
  </p>
</section>

<!-- BENEFITS -->

<section id="benefits">
  <div class="section-heading">
    <div class="eyebrow">Membership advantages</div>
    <h2>What Members <span>Can Access</span></h2>
    <div class="gold-line"></div>
  </div>

  <div class="grid">

    <div class="card">
      <h3>Business Visibility</h3>
      <p>
        Establish a business presence within a network
        focused on the building and construction industry.
      </p>
    </div>

    <div class="card">
      <h3>Professional Profiles</h3>
      <p>
        Give individual professionals an organised
        platform to present their experience and services.
      </p>
    </div>

    <div class="card">
      <h3>Independent Websites</h3>
      <p>
        Eligible business members may receive an
        independent business website according to
        their membership plan and separate service agreement.
      </p>
    </div>

    <div class="card">
      <h3>Business Discovery</h3>
      <p>
        Make it easier for potential customers and
        industry participants to discover relevant
        member businesses.
      </p>
    </div>

    <div class="card">
      <h3>Professional Referrals</h3>
      <p>
        Participate in a professional referral
        environment designed to encourage useful
        industry connections.
      </p>
    </div>

    <div class="card">
      <h3>Professional Ambassador Programme</h3>
      <p>
        Eligible professionals may apply for opportunities
        to represent and support the ABN community.
        Selection is subject to programme rules.
      </p>
    </div>

  </div>
</section>

<!-- REFERRAL PROGRAMME -->

<section class="dark-section" id="referrals">
  <div class="section-heading">
    <div class="eyebrow">Growing together</div>
    <h2>Professional Referral & <span>Networking</span></h2>
  </div>

  <div class="about-text">
    <p>
      ABN recognises the importance of professional
      relationships in the building and construction
      industry.
    </p>

    <p>
      Members may participate in professional referral
      opportunities by introducing relevant businesses,
      skilled providers and professionals to other
      members or prospective customers.
    </p>

    <p>
      Professional members may also have access to
      referral tracking and networking features as
      these systems are implemented.
    </p>

    <div class="highlight">
      Referral participation does not guarantee a
      contract, payment, customer, job or commercial
      outcome. Any referral reward or commission must
      be governed by a separate published programme.
    </div>
  </div>
</section>

<!-- ONBOARDING -->

<section id="onboarding">
  <div class="section-heading">
    <div class="eyebrow">Getting started</div>
    <h2>How to Become an <span>ABN Member</span></h2>
  </div>

  <div class="grid">

    <div class="card">
      <div class="number">01</div>
      <h3>Choose Membership</h3>
      <p>Select business or professional membership.</p>
    </div>

    <div class="card">
      <div class="number">02</div>
      <h3>Read the Agreement</h3>
      <p>Review the membership terms, conditions and privacy information.</p>
    </div>

    <div class="card">
      <div class="number">03</div>
      <h3>Accept the Terms</h3>
      <p>Submit your application after accepting the applicable agreement.</p>
    </div>

    <div class="card">
      <div class="number">04</div>
      <h3>Verification</h3>
      <p>Follow the verification requirements communicated by ABN.</p>
    </div>

    <div class="card">
      <div class="number">05</div>
      <h3>Membership Review</h3>
      <p>Your application is reviewed before membership approval.</p>
    </div>

    <div class="card">
      <div class="number">06</div>
      <h3>Activate Membership</h3>
      <p>Complete the applicable subscription process and onboarding.</p>
    </div>

  </div>
</section>

<!-- APPLICATION -->

<section class="dark-section" id="join">
  <div class="section-heading">
    <div class="eyebrow">Membership application</div>
    <h2>Apply to Join <span>ABN-7742</span></h2>
    <p>
      Complete the application details below.
      Submission does not automatically establish membership.
    </p>
  </div>

  <form id="applicationForm">

    <div class="form-grid">

      <div class="field">
        <label>Membership Type *</label>
        <select id="memberType" required>
          <option value="">Select membership</option>
          <option>Business Membership</option>
          <option>Professional Membership</option>
        </select>
      </div>

      <div class="field">
        <label>Full Name *</label>
        <input type="text" id="fullName" required>
      </div>

      <div class="field">
        <label>Business / Professional Name *</label>
        <input type="text" id="businessName" required>
      </div>

      <div class="field">
        <label>Email Address *</label>
        <input type="email" id="email" required>
      </div>

      <div class="field">
        <label>Telephone Number *</label>
        <input type="tel" id="phone" required>
      </div>

      <div class="field">
        <label>Country *</label>
        <input type="text" id="country" required>
      </div>

      <div class="field">
        <label>State / Region *</label>
        <input type="text" id="state" required>
      </div>

      <div class="field">
        <label>City / Location *</label>
        <input type="text" id="city" required>
      </div>

      <div class="field full">
        <label>Industry Category *</label>
        <select id="category" required>
          <option value="">Choose category</option>
          <option>Construction & Building</option>
          <option>Architecture</option>
          <option>Engineering</option>
          <option>Electrical Services</option>
          <option>Plumbing & Water</option>
          <option>Interior Design</option>
          <option>Building Materials</option>
          <option>Artisans & Skilled Trades</option>
          <option>Real Estate & Property</option>
          <option>Surveying & Land Services</option>
          <option>Consultancy & Project Services</option>
          <option>Other Industry Services</option>
        </select>
      </div>

      <div class="field full">
        <label>Describe Your Business or Professional Services *</label>
        <textarea id="description" required></textarea>
      </div>

      <div class="field full">
        <label>Website or Social Media Link (Optional)</label>
        <input type="url" id="website" placeholder="https://">
      </div>

    </div>

    <div class="checkline">
      <input type="checkbox" id="termsAccepted" required>
      <label for="termsAccepted">
        I confirm that I have read and agree to the
        ABN Membership Terms and Conditions.
      </label>
    </div>

    <div class="checkline">
      <input type="checkbox" id="privacyAccepted" required>
      <label for="privacyAccepted">
        I acknowledge the ABN Privacy Policy and consent
        to the handling of my application information
        for membership assessment.
      </label>
    </div>

    <button type="submit" class="btn btn-gold">
      SUBMIT MEMBERSHIP APPLICATION
    </button>

    <p class="form-message" id="formMessage"></p>

    <p class="note">
      This is an application interface. Live submission,
      verification, payment and membership approval
      require backend integration.
    </p>

  </form>
</section>

<!-- TERMS AND CONDITIONS -->

<section id="terms">
  <div class="section-heading">
    <div class="eyebrow">Legal information</div>
    <h2>Terms & <span>Conditions</span></h2>
  </div>

  <div class="policy">
    <p class="policy-date">
      ABN-7742 | Membership Terms and Conditions
    </p>

    <h3>1. Introduction</h3>
    <p>
